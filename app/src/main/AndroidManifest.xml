<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <application android:allowBackup="false" android:label="Correcteur Perso"
      android:supportsRtl="true" android:usesCleartextTraffic="false"
      android:theme="@android:style/Theme.Material.NoActionBar">
    <activity android:name=".SettingsActivity" android:exported="true" android:label="Correcteur Perso">
      <intent-filter>
        <action android:name="android.intent.action.MAIN"/>
        <category android:name="android.intent.category.LAUNCHER"/>
      </intent-filter>
    </activity>
    <activity android:name=".KeyboardSmokeActivity" android:exported="false"/>
    <service android:name=".PersonalKeyboardService"
      android:label="Correcteur Perso — français québécois"
      android:permission="android.permission.BIND_INPUT_METHOD" android:exported="true">
      <intent-filter><action android:name="android.view.InputMethod"/></intent-filter>
      <meta-data android:name="android.view.im" android:resource="@xml/method"/>
    </service>
  </application>
</manifest>
